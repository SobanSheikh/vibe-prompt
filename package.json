{
  "name": "vibe-prompt",
  "displayName": "Vibe Prompt",
  "description": "Private, local voice-to-text for prompts and code in VS Code.",
  "version": "0.9.0",
  "publisher": "sobansheikh",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SobanSheikh/vibe-prompt.git"
  },
  "homepage": "https://github.com/SobanSheikh/vibe-prompt#readme",
  "bugs": {
    "url": "https://github.com/SobanSheikh/vibe-prompt/issues"
  },
  "files": [
    "out/**",
    "media/**",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "codex",
    "voice",
    "dictation",
    "whisper",
    "speech-to-text"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:vibePrompt.transcript",
    "onCommand:vibePrompt.toggleRecording"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vibePrompt.toggleRecording",
        "title": "Vibe Prompt: Start or Stop Recording",
        "icon": "$(mic)"
      },
      {
        "command": "vibePrompt.startRecording",
        "title": "Vibe Prompt: Start Recording"
      },
      {
        "command": "vibePrompt.stopRecording",
        "title": "Vibe Prompt: Stop and Transcribe"
      },
      {
        "command": "vibePrompt.cancelRecording",
        "title": "Vibe Prompt: Cancel Recording"
      },
      {
        "command": "vibePrompt.copyTranscript",
        "title": "Vibe Prompt: Copy Transcript"
      },
      {
        "command": "vibePrompt.clearTranscript",
        "title": "Vibe Prompt: Clear Transcript"
      },
      {
        "command": "vibePrompt.openTranscript",
        "title": "Vibe Prompt: Open Transcript"
      },
      {
        "command": "vibePrompt.selectAudioInput",
        "title": "Vibe Prompt: Select Microphone"
      }
    ],
    "keybindings": [
      {
        "command": "vibePrompt.toggleRecording",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      },
      {
        "command": "vibePrompt.cancelRecording",
        "key": "escape",
        "when": "vibePrompt.recording"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "vibePromptPanel",
          "title": "Vibe Prompt",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "vibePromptPanel": [
        {
          "type": "webview",
          "id": "vibePrompt.transcript",
          "name": "Live Transcript"
        }
      ]
    },
    "configuration": {
      "title": "Vibe Prompt",
      "properties": {
        "vibePrompt.whisperBinaryPath": {
          "type": "string",
          "default": "whisper-cli",
          "description": "Path to the whisper.cpp command-line executable."
        },
        "vibePrompt.modelPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a local whisper.cpp GGML model file."
        },
        "vibePrompt.language": {
          "type": "string",
          "default": "en",
          "description": "Language code passed to whisper.cpp, or 'auto' for detection."
        },
        "vibePrompt.audioInput": {
          "type": "string",
          "default": "default",
          "description": "FFmpeg audio input device. Use 'default' for automatic selection, or choose a device from the Vibe Prompt panel."
        },
        "vibePrompt.ffmpegPath": {
          "type": "string",
          "default": "ffmpeg",
          "description": "Path to the FFmpeg executable."
        },
        "vibePrompt.previewIntervalMs": {
          "type": "number",
          "default": 3500,
          "minimum": 2000,
          "maximum": 15000,
          "description": "Interval between rolling transcript preview updates, in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "package": "vsce package",
    "package:linux-x64": "vsce package --target linux-x64",
    "package:linux-arm64": "vsce package --target linux-arm64",
    "package:win32-x64": "vsce package --target win32-x64",
    "package:win32-arm64": "vsce package --target win32-arm64",
    "package:darwin-x64": "vsce package --target darwin-x64",
    "package:darwin-arm64": "vsce package --target darwin-arm64"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
